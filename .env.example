# Template de variables de entorno para Vite
# Copia este archivo a `.env` para desarrollo local y personaliza los valores.
# NOTA: En Vite, solo las variables que comiencen con `VITE_` se expondrán al cliente.

# URL de la API del backend (si en el futuro se implementa una)
VITE_API_URL=http://localhost:5173

# Entorno de ejecución
VITE_APP_ENV=development
